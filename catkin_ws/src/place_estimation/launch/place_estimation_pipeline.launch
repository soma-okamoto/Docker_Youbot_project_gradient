<launch>
  <include file="$(find place_estimation)/launch/prior_distribution.launch" />

  <node pkg="place_estimation"
        type="observation_fusion_node_new.py"
        name="observation_fusion_node_multi_new"
        output="screen">
    <rosparam command="load"
              file="$(find place_estimation)/config/observation_fusion_multi_sensor.yaml" />
  </node>

  <include file="$(find place_estimation)/launch/distribution_visualization.launch" />
</launch>
